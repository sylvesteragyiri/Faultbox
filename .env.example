# App
# Copy to .env; dev scripts can generate it.

# Secret must be at least 32 bytes.
FAULTBOX_SECRET=
FAULTBOX_PORT=8080
FAULTBOX_DATABASE_PATH=data/faultbox.db

# Dashboard admin (first user only)
FAULTBOX_ADMIN_EMAIL=admin@example.com
FAULTBOX_ADMIN_PASSWORD=

# Public URL and proxy
# FAULTBOX_PUBLIC_URL=https://errors.example.com
# FAULTBOX_TRUST_PROXY=false

# Login protection (set both keys)
# FAULTBOX_TURNSTILE_SITE_KEY=
# FAULTBOX_TURNSTILE_SECRET_KEY=

# Limits and retention
# FAULTBOX_RETENTION_DAYS=30
# FAULTBOX_MAX_EVENT_KB=256
# FAULTBOX_RATE_LIMIT=50
# FAULTBOX_RATE_BURST=200
# FAULTBOX_QUEUE_SIZE=1000
# FAULTBOX_QUEUE_MAX_MB=32

# Runtime
# FAULTBOX_SHUTDOWN_TIMEOUT=10s
# FAULTBOX_LOG_LEVEL=info
